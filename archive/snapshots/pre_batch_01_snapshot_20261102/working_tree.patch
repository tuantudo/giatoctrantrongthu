-function handleHashRoute() {
-    let raw = window.location.hash || "#/";
-    raw = raw.replace(/^#+/, '');
-    if (!raw.startsWith('/')) raw = '/' + raw;
-    const route = raw.split('#')[0] || "/";
-
-    // Close any floating popup modals on route transition
