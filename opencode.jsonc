{
  "$schema": "https://opencode.ai/config.json",
  // GIA TỘC Agent Security Policy v0.1 — project boundary config.
  // Reasoning: last matching rule wins. Order: catch-all -> blanket runtime-interpreter policy ->
  // specific allows -> localhost network -> hard denies (denies last so they always win).

  "permission": {

    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      ".env.local": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*credentials*": "deny",
      "*cookies*": "deny",
      "cookie*": "deny",
      "*secret*": "deny",
      "*token*": "deny",
      "*.ged": "deny",
      ".env.example": "allow",
      "**/.env.example": "allow"
    },

    "edit": {
      "*": "ask",
      "/Users/tuantq/Projects/Personal/giatoctrantrongthu/**": "allow",
      "./**": "allow",
      "**/.aios/PROJECT_CONTRACT.json": "ask",
      "**/opencode.jsonc": "ask",
      "**/opencode.json": "ask",
      "**/*.ged": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*credentials*": "deny",
      "*/node_modules/**": "deny",
      "**/.env.example": "allow"
    },

    "external_directory": {
      "*": "ask",
      "/Users/tuantq/Projects/Personal/giatoctrantrongthu/**": "allow"
    },

    "bash": {
      "*": "ask",

      "node*": "ask",
      "nodejs*": "ask",
      "python3*": "ask",
      "python*": "ask",
      "npx*": "ask",
      "npm*": "ask",
      "bun*": "ask",
      "curl*": "ask",
      "gh*": "ask",
      "vercel*": "ask",
      "ssh*": "ask",
      "scp*": "ask",
      "rsync*": "ask",
      "git commit*": "ask",
      "git checkout*": "ask",
      "git switch*": "ask",
      "git reset*": "ask",
      "git restore*": "ask",
      "git remote*": "ask",
      "git stash*": "ask",
      "npm install*": "ask",
      "npm i*": "ask",
      "pip install*": "ask",
      "cp*": "ask",
      "mv*": "ask",
      "ln*": "ask",
      "rm *": "ask",

      "pwd": "allow",
      "ls*": "allow",
      "find*": "allow",
      "rg*": "allow",
      "grep*": "allow",
      "cat*": "allow",
      "head*": "allow",
      "tail*": "allow",
      "wc*": "allow",
      "tree*": "allow",
      "which*": "allow",
      "echo*": "allow",
      "mkdir*": "allow",
      "touch*": "allow",

      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git rev-parse*": "allow",
      "git grep*": "allow",
      "git add*": "allow",
      "git fetch*": "allow",

      "npm test*": "allow",
      "npm run *": "allow",
      "npm run": "allow",
      "npm ci*": "ask",
      "node --check*": "allow",
      "node server/*": "allow",
      "node scripts/*": "allow",
      "node --input-type=module --check*": "allow",
      "python3 generator/*": "allow",
      "python3 scripts/*": "allow",
      "python3 -m http.server*": "allow",

      "curl *localhost*": "allow",
      "curl *127.0.0.1*": "allow",

      "git push*": "deny",
      "git push --force*": "deny",
      "git reset --hard*": "deny",
      "git reset --merge*": "deny",
      "git clean*": "deny",
      "git rebase*": "deny",
      "git branch -D*": "deny",
      "git remote set-url*": "deny",
      "cat .env*": "deny",
      "cat */.env*": "deny",
      "cat */*/.env*": "deny",
      "cat *.key": "deny",
      "cat *.pem": "deny",
      "cat *cookies*": "deny",
      "cat *credentials*": "deny",
      "head .env*": "deny",
      "head */.env*": "deny",
      "tail .env*": "deny",
      "tail */.env*": "deny",
      "grep * .env*": "deny",
      "sudo*": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "rm -rf*": "deny",
      "rm -r*": "deny",
      "rm -f /*": "deny",
      "wget*": "deny",
      "npm publish*": "deny",
      "vercel --prod*": "deny",
      "vercel deploy --prod*": "deny",
      "gh repo delete*": "deny",
      "gh pr merge*": "deny",
      "*DROP TABLE*": "deny",
      "*DROP DATABASE*": "deny",
      "*TRUNCATE TABLE*": "deny",
      "*DELETE FROM*": "ask"
    },

    "doom_loop": "ask",
    "skill": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "todowrite": "allow"
  }
}
