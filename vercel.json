{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "admin.giatoctrantrongthu.com"
        }
      ],
      "destination": "/admin",
      "permanent": false
    },
    {
      "source": "/content/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/data/private/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/calendars/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/archive/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/AUDIT/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/server/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/scripts/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/tests/(.*)",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/login",
      "destination": "https://api.giatoctrantrongthu.com/login"
    },
    {
      "source": "/logout",
      "destination": "https://api.giatoctrantrongthu.com/logout"
    },
    {
      "source": "/help",
      "destination": "https://api.giatoctrantrongthu.com/help"
    },
    {
      "source": "/help/:path*",
      "destination": "https://api.giatoctrantrongthu.com/help/:path*"
    },
    {
      "source": "/me",
      "destination": "https://api.giatoctrantrongthu.com/me"
    },
    {
      "source": "/me/:path*",
      "destination": "https://api.giatoctrantrongthu.com/me/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://api.giatoctrantrongthu.com/api/:path*"
    },
    {
      "source": "/assets/private/:path*",
      "destination": "https://api.giatoctrantrongthu.com/assets/private/:path*"
    }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, private" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "X-Robots-Tag", "value": "noindex, noarchive, nofollow, nosnippet" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/me(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, private" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "X-Robots-Tag", "value": "noindex, noarchive, nofollow, nosnippet" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/login",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, private" },
        { "key": "X-Robots-Tag", "value": "noindex, noarchive, nofollow, nosnippet" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, private" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
