# ============================================================================
# GIA TỘC TRẦN TRỌNG THU — SERVER ENVIRONMENT TEMPLATE (V1.0)
# ============================================================================

# [1. RUNTIME & SESSION SECURITY]
# For NAS Production behind Vercel Same-Origin Rewrite Proxy:
# - MUST set NODE_ENV=production and DEV_AUTO_LOGIN=false
# - Leave COOKIE_DOMAIN= empty (host-only cookie on giatoctrantrongthu.com)
#   or set .giatoctrantrongthu.com — NEVER set api.giatoctrantrongthu.com!
NODE_ENV=production
PORT=3000
SESSION_SECRET=CHANGE_ME_TO_LONG_RANDOM_STRING_FOR_PRODUCTION
COOKIE_DOMAIN=

# [2. PROXY, CORS & MEDIA BASE URL]
# Trusted origins for Anti-CSRF & Admin CORS behind Vercel Proxy + Cloudflare Tunnel:
ALLOWED_ORIGINS=https://giatoctrantrongthu.com,https://www.giatoctrantrongthu.com,https://admin.giatoctrantrongthu.com,https://api.giatoctrantrongthu.com
ADMIN_ORIGIN=https://giatoctrantrongthu.com,https://admin.giatoctrantrongthu.com

# Relative "/" works identically on local dev and Vercel Same-Origin Proxy.
# Only set https://api.giatoctrantrongthu.com if serving assets from a separate unproxied origin.
MEDIA_BASE_URL=/

# [3. LOCAL DEV AUTO-LOGIN — STRICTLY DISABLED IN PRODUCTION]
DEV_AUTO_LOGIN=false
DEV_AUTO_LOGIN_ACCOUNT=tuantq

# [4. DATABASE CONFIGURATION]
# Local development: DB_CLIENT=sqlite3
# NAS Production (MariaDB): DB_CLIENT=mysql
DB_CLIENT=sqlite3
DB_PATH=./family_archive.db

# MariaDB Production Credentials (uncomment when DB_CLIENT=mysql):
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=your_user
# DB_PASSWORD=your_password
# DB_NAME=family_archive
